FROM ghcr.io/charmbracelet/vhs:latest@sha256:ea49a6a1c529be83153e88321892b5585964418f0b9055e8c1e0d732194234a3
LABEL wtf.metio.ci.root-allowed="records the VHS demo from throwaway demo data"

RUN mkdir /storage
RUN chmod 777 /storage

RUN mkdir /config
RUN chmod 777 /config

COPY target/release/pasejo /usr/local/bin/pasejo
COPY vhs/identity /secret/identity
COPY vhs/recipient /public/recipient

ENV PASEJO_CONFIG=/config/pasejo.toml
