# Build from the repository root:
#   podman build --file crates/pasejo-server/Containerfile --tag pasejo-server .
# The builder runs on the build machine's platform and cross-compiles to the
# target platform, so a multi-platform build needs no emulation.
FROM --platform=$BUILDPLATFORM docker.io/library/rust:1.100.0-trixie@sha256:e19840879045c951c905d0eaa9887f3439c62000e429963371b376bac8d38c31 AS build
ARG TARGETARCH
ARG VERSION=development
WORKDIR /src
COPY . .
RUN dev/build-static.sh pasejo-server "${TARGETARCH}" /pasejo-server "${VERSION}" \
    && mkdir -p /data

# The release exports this stage as the binary archive's content.
FROM scratch AS binary
COPY --from=build /pasejo-server /pasejo-server

FROM gcr.io/distroless/static:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329
LABEL org.opencontainers.image.title="pasejo-server" \
      org.opencontainers.image.description="Server that syncs pasejo remote stores, manages organizations and audits access" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.source="https://github.com/metio/pasejo"
COPY --from=build /pasejo-server /usr/bin/pasejo-server
COPY --from=build --chown=65532:65532 /data /var/lib/pasejo-server
COPY LICENSES/AGPL-3.0-or-later.txt /usr/share/licenses/pasejo-server/AGPL-3.0-or-later.txt
ENV PASEJO_SERVER_CONFIG=/etc/pasejo-server/config.toml
WORKDIR /var/lib/pasejo-server
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/bin/pasejo-server"]
CMD ["serve"]
